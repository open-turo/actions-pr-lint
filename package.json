{
  "author": "Turo engineering",
  "description": "GitHub Actions for PR description validation",
  "devDependencies": {
    "lerna": "9.0.7"
  },
  "engines": {
    "node": ">= 24.0.0"
  },
  "workspaces": [
    "check-pr-checklist"
  ],
  "license": "MIT",
  "name": "@open-turo/actions-pr-lint",
