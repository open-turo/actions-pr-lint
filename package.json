{
  "author": "Turo engineering",
  "description": "GitHub Actions for PR description validation",
  "devDependencies": {
    "@open-turo/eslint-config-typescript": "23.2.3",
    "@types/node": "24.19.0",
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "9.39.5",
    "lerna": "10.0.1",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">= 24.0.0"
  },
  "workspaces": [
    "check-jira-reference",
    "check-pr-checklist"
  ],
  "license": "MIT",
  "overrides": {
    "js-yaml": "5.4.2"
  },
